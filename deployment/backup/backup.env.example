# Copy to /etc/lakupos-backup.env on the VPS, then: chown root:root and chmod 600.
# Never commit the real file: it holds the database password.

# Supabase dashboard > Connect > "Session pooler" (IPv4). Use the database password, not an API key.
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@<pooler-host>:5432/postgres"

BACKUP_DIR=/var/backups/lakupos
KEEP_DAILY=14      # daily dumps kept on the VPS
KEEP_WEEKLY=8      # Sunday dumps kept on the VPS (8 weeks, inside the contract's 60-day limit)
MIN_TABLES=30      # fail if the dump holds fewer tables with data than this

# Recommended: encrypt dumps with age. Only the PUBLIC key goes on the VPS;
# keep the private key on the laptop. Generate with: age-keygen -o lakupos-backup.key
AGE_RECIPIENT=""

# Optional off-site copy with rclone (configure the remote first with `rclone config`).
RCLONE_REMOTE=""   # e.g. gdrive:lakupos-backup
OFFSITE_KEEP_DAYS=56

# Optional: ping a monitor (e.g. healthchecks.io) so a missed or failed backup alerts you.
HEALTHCHECK_URL=""
